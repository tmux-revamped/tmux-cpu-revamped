#!/bin/sh
[ -n "${ZSH_VERSION:-}" ] && emulate sh
set -eu

cpu_revamped_self="$0"
case "${cpu_revamped_self}" in
*/*) ;;
*) cpu_revamped_self="$(command -v -- "${cpu_revamped_self}")" ;;
esac
cpu_revamped_lib="$(cd "${cpu_revamped_self%/*}/../lib" && pwd)" || exit 1

for cpu_revamped_inherited in $(env | sed -n -e 's/^\(REVAMPED_[A-Za-z0-9_]*\)=.*/\1/p' -e 's/^\(CPU_REVAMPED_[A-Za-z0-9_]*_LOADED\)=.*/\1/p'); do
  case "${cpu_revamped_inherited}" in
  REVAMPED_TEST_*) continue ;;
  *) unset "${cpu_revamped_inherited}" ;;
  esac
done

REVAMPED_LIB="${cpu_revamped_lib}"
# shellcheck source=SCRIPTDIR/../lib/core.sh
. "${REVAMPED_LIB}/core.sh"
# shellcheck source=SCRIPTDIR/../lib/cpu.sh
. "${REVAMPED_LIB}/cpu.sh"

cpu_revamped_interface() {
  # shellcheck disable=SC2034
  REVAMPED_UI_NAME=cpu-revamped REVAMPED_UI_VERSION="${CPU_REVAMPED_VERSION}" REVAMPED_UI_TAGLINE="load, temperature and clock in the status bar"
  if [ -n "${CPU_REVAMPED_ACCENT:-}" ]; then
    # shellcheck disable=SC2034
    REVAMPED_UI_ACCENT_CHOICE="${CPU_REVAMPED_ACCENT}" REVAMPED_UI_ACCENT_NAME=CPU_REVAMPED_ACCENT
  fi
  # shellcheck source=SCRIPTDIR/../lib/cli.sh
  . "${REVAMPED_LIB}/cli.sh"
  # shellcheck source=SCRIPTDIR/../lib/doctor.sh
  . "${REVAMPED_LIB}/doctor.sh"
}

cpu_revamped_usage() {
  cpu_revamped_interface
  revamped_cli_usage_error "$1"
}

cpu_revamped_bad() {
  cpu_revamped_interface
  revamped_cli_die "$1"
}

cpu_revamped_help() {
  revamped_cli_help_page <<'HELP'
cpu-revamped - load, temperature and clock in the status bar

usage:
  cpu-revamped apply          bind the key and fill the placeholders
  cpu-revamped list           print what apply would send to tmux
  cpu-revamped status NAME    print one placeholder: percentage, icon,
                              fg_color, bg_color, temp, temp_icon,
                              temp_fg_color, temp_bg_color, freq, load,
                              load5, load15, count, graph, top_process,
                              governor, load_color, alert, cores,
                              sep_left, sep_right or throttle
  cpu-revamped refresh        sample the CPU now for the status line
  cpu-revamped card           print every figure as a table
  cpu-revamped popup          open a CPU monitor in a tmux popup
  cpu-revamped daemon         publish the placeholders on every tick, for
                              the options render mode
  cpu-revamped doctor         check this machine
  cpu-revamped version        print the version
  cpu-revamped help           print this page

keys:
  --popup-key KEY             the prefix key for the monitor popup, or off
  --popup-width SIZE          the popup's width, such as 80%
  --popup-height SIZE         the popup's height, such as 60%
  --popup-command COMMAND     what the popup runs, default btop, htop or top

sampling:
  --interval SECONDS          how long a sample stays fresh
  --detail-interval SECONDS   how long the temperature, the clock, the load
                              average, the busiest process and the governor
                              stay fresh
  --throttle-when-detached 0|1
                              1 stops sampling while no client is attached
  --render MODE               jobs or options
  --graph-width COUNT         samples kept for the graph

tiers:
  --medium-thresh PERCENT     where the medium load tier starts
  --high-thresh PERCENT       where the high load tier starts
  --TIER-icon TEXT            what #{cpu_icon} prints in the low, medium
                              or high tier
  --TIER-fg-color STYLE       what #{cpu_fg_color} prints in each tier
  --TIER-bg-color STYLE       what #{cpu_bg_color} prints in each tier
  --temp-medium-thresh DEGREES
                              where the medium temperature tier starts
  --temp-high-thresh DEGREES  where the high temperature tier starts
  --temp-TIER-icon TEXT       what #{cpu_temp_icon} prints in each tier
  --temp-TIER-fg-color STYLE  what #{cpu_temp_fg_color} prints in each tier
  --temp-TIER-bg-color STYLE  what #{cpu_temp_bg_color} prints in each tier
  --load-medium-ratio RATIO   load average per core that turns
                              #{cpu_load_color} medium
  --load-high-ratio RATIO     load average per core that turns it high
  --alert-icon TEXT           what #{cpu_alert} prints while the load or
                              the temperature is high
  --throttle-icon TEXT        what #{cpu_throttle} prints while the CPU is
                              held back
  --notify 0|1                1 sends a desktop notification when
                              throttling starts, once per episode

powerline:
  --sep-left TEXT             what #{cpu_sep_left} prints, default the left
                              arrow
  --sep-right TEXT            what #{cpu_sep_right} prints, default the right
                              arrow
  --sep-bg STYLE              the colour behind the arrows, default default

formats:
  --percentage-format FORMAT  printf format of the load percent
  --temp-format FORMAT        printf format of the temperature
  --temp-unit C|F             the unit of the temperature
  --freq-format FORMAT        printf format of the clock in megahertz
  --load-format FORMAT        printf format of the three load averages
  --icons SET                 ascii, or nerd for a Nerd Font glyph before
                              every metric
  --METRIC-label TEXT         the label before one metric
  --fixed-width on|off        on pads every figure to its natural width
  --METRIC-width COUNT        the width of one metric

output:
  --json                      list prints one JSON object
  --theme NAME                the look: kodougu, catppuccin-mocha,
                              catppuccin-latte, dracula, nord, gruvbox,
                              tokyo-night or mono

environment:
  CPU_REVAMPED_<SETTING>   the same as the option of that name, such as
                           CPU_REVAMPED_INTERVAL for --interval
  CPU_REVAMPED_THEME       the look, when --theme is not given
  CPU_REVAMPED_ACCENT      a colour such as #CBA6F7 for the accent
  KODOUGU_THEME            the family look, when neither is given
  KODOUGU_ACCENT           the family accent, when the tool's is unset
  NO_COLOR                 turn colour off

tmux options:
  @cpu_revamped_popup_key           the monitor popup key (default M-c)
  @cpu_revamped_popup_width         width of the popup (default 80%)
  @cpu_revamped_popup_height        height of the popup (default 80%)
  @cpu_revamped_popup_command       what the popup runs (default btop,
                                    htop or top)
  @cpu_revamped_interval            seconds a sample stays fresh
                                    (default 5)
  @cpu_revamped_detail_interval     seconds the temperature, the clock, the
                                    load average, the busiest process and
                                    the governor stay fresh (default 60)
  @cpu_revamped_throttle_when_detached
                                    1 stops sampling while no client is
                                    attached (default 0)
  @cpu_revamped_render              jobs or options (default jobs)
  @cpu_revamped_graph_width         samples kept for the graph (default 20)
  @cpu_revamped_medium_thresh       percent that starts the medium tier
                                    (default 30)
  @cpu_revamped_high_thresh         percent that starts the high tier
                                    (default 80)
  @cpu_revamped_temp_medium_thresh  degrees that start the medium
                                    temperature tier (default 65)
  @cpu_revamped_temp_high_thresh    degrees that start the high
                                    temperature tier (default 80)
  @cpu_revamped_load_medium_ratio   load average per core that starts the
                                    medium load colour (default 0.7)
  @cpu_revamped_load_high_ratio     load average per core that starts the
                                    high load colour (default 1.0)
  @cpu_revamped_<tier>_icon         icon of the low, medium or high tier
                                    (default one, two or three bars)
  @cpu_revamped_<tier>_fg_color     style of #{cpu_fg_color} in each tier
                                    (default none)
  @cpu_revamped_<tier>_bg_color     style of #{cpu_bg_color} in each tier
                                    (default none)
  @cpu_revamped_temp_<tier>_icon    icon of #{cpu_temp_icon} (default none)
  @cpu_revamped_temp_<tier>_fg_color
                                    style of #{cpu_temp_fg_color}
                                    (default none)
  @cpu_revamped_temp_<tier>_bg_color
                                    style of #{cpu_temp_bg_color}
                                    (default none)
  @cpu_revamped_alert_icon          text of #{cpu_alert} (default !)
  @cpu_revamped_throttle_icon       text of #{cpu_throttle}
                                    (default throttled)
  @cpu_revamped_notify              1 notifies once when throttling starts
                                    (default 0)
  @cpu_revamped_sep_left            text of #{cpu_sep_left} (default the
                                    left powerline arrow)
  @cpu_revamped_sep_right           text of #{cpu_sep_right} (default the
                                    right powerline arrow)
  @cpu_revamped_sep_bg              colour behind the arrows
                                    (default default)
  @cpu_revamped_temp_unit           C or F (default C)
  @cpu_revamped_percentage_format   format of #{cpu_percentage}
                                    (default "%s%%")
  @cpu_revamped_temp_format         format of #{cpu_temp}
                                    (default "%s" and the degree sign
                                    and the unit)
  @cpu_revamped_freq_format         format of #{cpu_freq}
                                    (default "%sMHz")
  @cpu_revamped_load_format         format of #{cpu_load}, #{cpu_load5}
                                    and #{cpu_load15} (default "%s")
  @cpu_revamped_icons               ascii or nerd (default ascii)
  @cpu_revamped_fixed_width         on or off (default off)
  @cpu_revamped_<metric>_label      label before one metric (default none)
  @cpu_revamped_<metric>_width      width of one metric (default none)
  @revamped_theme                   the family look (default kodougu)

notes:
  A metric that takes a label and a width is percentage, temp, freq, load,
  load5, load15, count, graph, cores, top_process or governor, written
  with dashes in an option, such as --top-process-label. The graph width
  is also the number of samples the graph keeps. An icon, a label or a
  text set to off prints nothing.
  The placeholders are #{cpu_<name>} for each name status takes. Each
  prints the stored sample at once, and starts one background sample when
  it is older than the interval. The temperature, the clock, the load
  averages, the busiest process, the governor, the per-core load and
  the throttling flag are read only for a placeholder the status line
  uses. #{cpu_cores} prints one bar per core, from the change of the
  counters since the previous sample, so the first sample prints
  nothing. #{cpu_throttle} prints while the CPU is held back, and
  --notify 1 needs it in the status line. With --render options each
  placeholder reads a tmux option that a background process fills on
  every tick, so a status refresh starts no process.

examples:
  cpu-revamped status percentage
  cpu-revamped card
  cpu-revamped --icons nerd --fixed-width on apply
  cpu-revamped list --json
HELP
}

cpu_revamped_show_version() {
  cpu_revamped_show_version_tmux=$(tmux -V 2>/dev/null) || cpu_revamped_show_version_tmux=missing
  printf '%s %s\n' cpu-revamped "${CPU_REVAMPED_VERSION}"
  printf 'tmux: %s\n' "${cpu_revamped_show_version_tmux#tmux }"
}

cpu_revamped_doctor_source() {
  cpu_revamped_doctor_source_path=$(command -v "$1" 2>/dev/null) || cpu_revamped_doctor_source_path=""
  if [ -n "${cpu_revamped_doctor_source_path}" ]; then
    revamped_doctor_line "$1" ok "${cpu_revamped_doctor_source_path}, $2"
    return 0
  fi
  revamped_doctor_line "$1" warn "$3"
}

cpu_revamped_doctor_file() {
  if cat "$2" >/dev/null 2>&1; then
    revamped_doctor_line "$1" ok "$2, $3"
    return 0
  fi
  revamped_doctor_line "$1" warn "$4"
}

cpu_revamped_doctor_cores() {
  if revamped_has_command osascript; then
    cpu_revamped_doctor_source osascript "reads the per-core load through JXA" ""
    return 0
  fi
  if revamped_has_command macmon; then
    revamped_doctor_line cores ok "macmon reads the per-core load"
    return 0
  fi
  revamped_doctor_line cores warn "without osascript or macmon the per-core bars stay empty"
}

cpu_revamped_doctor_macos() {
  if revamped_has_command iostat; then
    cpu_revamped_doctor_source iostat "reads the load" "without it the load comes from top"
  else
    cpu_revamped_doctor_source top "reads the load" "without iostat or top the load stays 0"
  fi
  cpu_revamped_doctor_source sysctl "reads the clock, the load average and the core count" "without it those figures stay empty"
  cpu_revamped_doctor_source macmon "reads the temperature on Apple Silicon" "without it the temperature stays empty on Apple Silicon"
  cpu_revamped_doctor_source osx-cpu-temp "reads the temperature on an Intel Mac" "the temperature falls back to istats on an Intel Mac"
  cpu_revamped_doctor_source istats "reads the temperature when osx-cpu-temp is missing" "without it and osx-cpu-temp the temperature stays empty on an Intel Mac"
  revamped_doctor_line governor warn "macOS has no CPU governor, so the governor stays empty"
  cpu_revamped_doctor_cores
  cpu_revamped_doctor_source pmset "reads the thermal limit for the throttling flag" "without it the throttling flag stays off"
}

cpu_revamped_doctor_throttle() {
  for cpu_revamped_doctor_throttle_file in "${CPU_REVAMPED_SYS}"/devices/system/cpu/cpu*/thermal_throttle/*_throttle_count; do
    break
  done
  cpu_revamped_doctor_file throttle "${cpu_revamped_doctor_throttle_file}" "counts the throttling events" "no thermal_throttle counter is readable, so the throttling flag stays off"
}

cpu_revamped_doctor_linux() {
  cpu_revamped_doctor_file stat /proc/stat "holds the load" "/proc/stat cannot be read, so the load stays 0"
  cpu_revamped_doctor_file loadavg /proc/loadavg "holds the load averages" "/proc/loadavg cannot be read, so the load averages stay empty"
  cpu_revamped_doctor_file cpuinfo /proc/cpuinfo "holds the core count and the clock" "/proc/cpuinfo cannot be read, so the core count stays empty"
  cpu_revamped_doctor_file governor "${CPU_REVAMPED_SYS}/devices/system/cpu/cpu0/cpufreq/scaling_governor" "holds the governor" "no scaling governor is readable, so the governor stays empty"
  cpu_revamped_doctor_source sensors "reads the temperature when no thermal zone, coretemp or k10temp does" "the temperature needs a thermal zone, coretemp, k10temp or sensors"
  cpu_revamped_doctor_throttle
}

cpu_revamped_doctor_monitor() {
  cpu_revamped_monitor
  cpu_revamped_doctor_monitor_program="${CPU_REVAMPED_MONITOR%% *}"
  cpu_revamped_doctor_monitor_path=$(command -v "${cpu_revamped_doctor_monitor_program}" 2>/dev/null) || cpu_revamped_doctor_monitor_path=""
  if [ -n "${cpu_revamped_doctor_monitor_path}" ]; then
    revamped_doctor_line monitor ok "${cpu_revamped_doctor_monitor_path}, opens in the popup"
    return 0
  fi
  revamped_doctor_line monitor warn "${cpu_revamped_doctor_monitor_program} is not installed, so the popup names it in a message"
}

cpu_revamped_doctor_popup() {
  cpu_revamped_popup_check
  case "${CPU_REVAMPED_POPUP_OK}" in
  1) revamped_doctor_line popup ok "tmux ${CPU_REVAMPED_TMUX} opens the detail popup" ;;
  *) revamped_doctor_line popup warn "the detail popup needs tmux ${CPU_REVAMPED_POPUP_SINCE} or later" ;;
  esac
}

cpu_revamped_doctor_keys() {
  if [ -n "${CPU_REVAMPED_SKIPPED}" ]; then
    revamped_doctor_line keys warn "already bound and left alone: ${CPU_REVAMPED_SKIPPED}"
    return 0
  fi
  revamped_doctor_line keys ok "every key it binds is free or its own"
}

cpu_revamped_doctor_settings() {
  cpu_revamped_doctor_settings_rows=$(cpu_revamped_setting_rows)
  # shellcheck disable=SC2154
  revamped_doctor_settings "${CPU_REVAMPED_KINDS}" "${cpu_revamped_doctor_settings_rows}"
}

cpu_revamped_doctor() {
  cpu_revamped_plan
  revamped_doctor_tmux
  cpu_revamped_doctor_popup
  if revamped_is_macos; then
    cpu_revamped_doctor_macos
  else
    cpu_revamped_doctor_linux
  fi
  cpu_revamped_doctor_source ps "names the busiest process" "without it the busiest process stays empty"
  cpu_revamped_doctor_monitor
  revamped_doctor_notifier
  cpu_revamped_doctor_settings
  cpu_revamped_doctor_keys
  revamped_doctor_gum
  revamped_doctor_core_tools awk sed tr date cat
  revamped_doctor_finish
  [ "${REVAMPED_DOCTOR_MISSING}" -eq 0 ] || exit 1
}

cpu_revamped_list() {
  cpu_revamped_plan
  if [ -n "${cpu_revamped_json}" ]; then
    cpu_revamped_json
    return 0
  fi
  cpu_revamped_lines
}

cpu_revamped_apply_command() {
  cpu_revamped_apply
  cpu_revamped_apply_command_sent=$(cpu_revamped_bindings)
  case "${cpu_revamped_apply_command_sent}" in
  1) printf 'Applied. 1 key is bound.\n' ;;
  *) printf 'Applied. %s keys are bound.\n' "${cpu_revamped_apply_command_sent}" ;;
  esac
}

cpu_revamped_read_all() {
  cpu_revamped_load
  CPU_REVAMPED_WANT="${CPU_REVAMPED_S_published}"
  [ "$1" != all ] || CPU_REVAMPED_WANT="${CPU_REVAMPED_METRICS}"
  cpu_revamped_refresh
  [ "${CPU_REVAMPED_STORED}" = 1 ] || cpu_revamped_bad "no tmux server is running, so the sample has nowhere to go"
}

cpu_revamped_closing() {
  printf '%s. %s%% of the CPU is busy.\n' "$1" "${CPU_REVAMPED_S_percent}"
}

cpu_revamped_refresh_command() {
  cpu_revamped_read_all published
  cpu_revamped_closing Refreshed
}

cpu_revamped_card_row() {
  CPU_REVAMPED_CARD="${CPU_REVAMPED_CARD}$1	${2:--}
"
}

cpu_revamped_card_rows() {
  CPU_REVAMPED_CARD=""
  cpu_revamped_card_row Load "${CPU_REVAMPED_S_percent:+${CPU_REVAMPED_S_percent}%}"
  cpu_revamped_value temp
  cpu_revamped_card_row Temperature "${CPU_REVAMPED_OUT}"
  cpu_revamped_value freq
  cpu_revamped_card_row Clock "${CPU_REVAMPED_OUT}"
  cpu_revamped_card_row "Load average" "${CPU_REVAMPED_S_load:+${CPU_REVAMPED_S_load} ${CPU_REVAMPED_S_load5} ${CPU_REVAMPED_S_load15}}"
  cpu_revamped_card_row Cores "${CPU_REVAMPED_S_count}"
  cpu_revamped_card_row Governor "${CPU_REVAMPED_S_governor}"
  cpu_revamped_card_row "Top process" "${CPU_REVAMPED_S_top_process:+${CPU_REVAMPED_S_top_process#* }, ${CPU_REVAMPED_S_top_process%% *}%}"
  cpu_revamped_value_graph
  cpu_revamped_card_row History "${CPU_REVAMPED_OUT}"
}

cpu_revamped_card() {
  cpu_revamped_read_all all
  cpu_revamped_card_rows
  cpu_revamped_card_closing=$(cpu_revamped_closing Read)
  if revamped_ui_out; then
    printf 'Figure\tValue\n%s' "${CPU_REVAMPED_CARD}" | revamped_ui_table
    revamped_ui_done "${cpu_revamped_card_closing}"
    return 0
  fi
  printf '%s' "${CPU_REVAMPED_CARD}" | awk -F '\t' '{ printf "%-18s %s\n", $1, $2 }'
  printf '%s\n' "${cpu_revamped_card_closing}"
}

cpu_revamped_status_command() {
  case " ${CPU_REVAMPED_METRICS} " in
  *" ${1:-} "*) cpu_revamped_status "$1" ;;
  *) cpu_revamped_status_refused "${1:-}" ;;
  esac
}

cpu_revamped_status_refused() {
  [ -n "$1" ] || cpu_revamped_usage "no placeholder given"
  cpu_revamped_bad "status must be percentage, icon, fg_color, bg_color, temp, temp_icon, temp_fg_color, temp_bg_color, freq, load, load5, load15, count, graph, top_process, governor, load_color, alert, cores, sep_left, sep_right or throttle, got: $1"
}

cpu_revamped_daemon_command() {
  set +e
  cpu_revamped_daemon
  cpu_revamped_daemon_command_ended=$?
  set -e
  [ "${cpu_revamped_daemon_command_ended}" -ne 0 ] || exec "${cpu_revamped_self}" daemon
}

cpu_revamped_start_menu() {
  revamped_cli_require_terminal
  cpu_revamped_start_menu_choice=$(revamped_cli_menu "Show the CPU now" "List the bindings" "Apply them now" "Check this machine" "Help")
  case "${cpu_revamped_start_menu_choice}" in
  "Show the CPU now") cpu_revamped_card ;;
  "List the bindings") cpu_revamped_list ;;
  "Apply them now") cpu_revamped_apply_command ;;
  "Check this machine") cpu_revamped_doctor ;;
  *) cpu_revamped_help ;;
  esac
}

cpu_revamped_dispatch() {
  case "${1:-}" in
  doctor) cpu_revamped_doctor ;;
  version | --version | -V) cpu_revamped_show_version ;;
  help | --help | -h) cpu_revamped_help ;;
  list) cpu_revamped_list ;;
  card) cpu_revamped_card ;;
  refresh) cpu_revamped_refresh_command ;;
  "") cpu_revamped_start_menu ;;
  *) revamped_cli_usage_error "unknown command '$1'" ;;
  esac
}

cpu_revamped_known() {
  [ "$1" != --theme ] || return 0
  cpu_revamped_known_name=$(cpu_revamped_setting_name "$1")
  [ -n "${cpu_revamped_known_name}" ] || cpu_revamped_usage "unknown option '$1'"
}

cpu_revamped_set() {
  cpu_revamped_set_upper=$(printf '%s\n' "$1" | tr '[:lower:]' '[:upper:]')
  export "CPU_REVAMPED_${cpu_revamped_set_upper}=$2"
}

cpu_revamped_option() {
  cpu_revamped_option_name=$(cpu_revamped_setting_name "$1")
  [ -n "${cpu_revamped_option_name}" ] || cpu_revamped_usage "unknown option '$1'"
  cpu_revamped_set "${cpu_revamped_option_name}" "$2"
}

cpu_revamped_check_numbers() {
  cpu_revamped_check_numbers_bad=$(env | awk -F '=' '$1 ~ /^CPU_REVAMPED_(INTERVAL|DETAIL_INTERVAL|GRAPH_WIDTH|[A-Z_]+_THRESH|[A-Z_]+_WIDTH)$/ && $1 != "CPU_REVAMPED_FIXED_WIDTH" && $1 != "CPU_REVAMPED_POPUP_WIDTH" { value = substr($0, length($1) + 2); if (value != "" && value !~ /^[0-9]+$/) { name = tolower(substr($1, 14)); gsub(/_/, "-", name); if (bad == "") { bad = name "=" value } } } END { if (bad != "") { print bad } }')
  [ -z "${cpu_revamped_check_numbers_bad}" ] || cpu_revamped_bad "--${cpu_revamped_check_numbers_bad%%=*} must be a whole number, got: ${cpu_revamped_check_numbers_bad#*=}"
}

cpu_revamped_check_ratios() {
  cpu_revamped_check_ratios_bad=$(env | awk -F '=' '$1 ~ /^CPU_REVAMPED_LOAD_(MEDIUM|HIGH)_RATIO$/ { value = substr($0, length($1) + 2); if (value != "" && value !~ /^[0-9]+(\.[0-9]+)?$/) { name = tolower(substr($1, 14)); gsub(/_/, "-", name); if (bad == "") { bad = name "=" value } } } END { if (bad != "") { print bad } }')
  [ -z "${cpu_revamped_check_ratios_bad}" ] || cpu_revamped_bad "--${cpu_revamped_check_ratios_bad%%=*} must be a number, got: ${cpu_revamped_check_ratios_bad#*=}"
}

cpu_revamped_check_choices() {
  case "${CPU_REVAMPED_ICONS-ascii}" in
  ascii | nerd) : ;;
  *) cpu_revamped_bad "--icons must be ascii or nerd, got: ${CPU_REVAMPED_ICONS}" ;;
  esac
  case "${CPU_REVAMPED_FIXED_WIDTH-off}" in
  on | off) : ;;
  *) cpu_revamped_bad "--fixed-width must be on or off, got: ${CPU_REVAMPED_FIXED_WIDTH}" ;;
  esac
  case "${CPU_REVAMPED_TEMP_UNIT-C}" in
  C | F) : ;;
  *) cpu_revamped_bad "--temp-unit must be C or F, got: ${CPU_REVAMPED_TEMP_UNIT}" ;;
  esac
  case "${CPU_REVAMPED_THROTTLE_WHEN_DETACHED-0}" in
  0 | 1) : ;;
  *) cpu_revamped_bad "--throttle-when-detached must be 0 or 1, got: ${CPU_REVAMPED_THROTTLE_WHEN_DETACHED}" ;;
  esac
  case "${CPU_REVAMPED_NOTIFY-0}" in
  0 | 1) : ;;
  *) cpu_revamped_bad "--notify must be 0 or 1, got: ${CPU_REVAMPED_NOTIFY}" ;;
  esac
  case "${CPU_REVAMPED_RENDER-jobs}" in
  jobs | options) return 0 ;;
  *) cpu_revamped_bad "--render must be jobs or options, got: ${CPU_REVAMPED_RENDER}" ;;
  esac
}

cpu_revamped_check() {
  cpu_revamped_check_numbers
  cpu_revamped_check_ratios
  cpu_revamped_check_choices
}

cpu_revamped_main() {
  cpu_revamped_theme="${CPU_REVAMPED_THEME:-}" cpu_revamped_json="" cpu_revamped_left=$# cpu_revamped_rest=0
  while [ "${cpu_revamped_left}" -gt 0 ]; do
    cpu_revamped_arg="$1"
    shift
    cpu_revamped_left=$((cpu_revamped_left - 1))
    case "${cpu_revamped_rest}:${cpu_revamped_arg}" in
    1:*) set -- "$@" "${cpu_revamped_arg}" ;;
    0:--) cpu_revamped_rest=1 ;;
    0:--json) cpu_revamped_json=1 ;;
    0:-h | 0:-V | 0:--help | 0:--version) set -- "$@" "${cpu_revamped_arg}" ;;
    0:--theme=*) cpu_revamped_theme="${cpu_revamped_arg#--theme=}" ;;
    0:--*=*) cpu_revamped_option "${cpu_revamped_arg%%=*}" "${cpu_revamped_arg#*=}" ;;
    0:--*)
      cpu_revamped_known "${cpu_revamped_arg}"
      [ "${cpu_revamped_left}" -gt 0 ] || cpu_revamped_usage "option '${cpu_revamped_arg}' needs a value"
      if [ "${cpu_revamped_arg}" = --theme ]; then
        cpu_revamped_theme="$1"
      else
        cpu_revamped_option "${cpu_revamped_arg}" "$1"
      fi
      shift
      cpu_revamped_left=$((cpu_revamped_left - 1))
      ;;
    0:-?*) cpu_revamped_usage "unknown option '${cpu_revamped_arg}'" ;;
    *) set -- "$@" "${cpu_revamped_arg}" ;;
    esac
  done
  cpu_revamped_check
  cpu_revamped_run "${cpu_revamped_theme}" "$@"
}

cpu_revamped_run() {
  cpu_revamped_run_theme="$1"
  shift
  [ -z "${cpu_revamped_json}" ] || [ "${1:-}" = list ] || cpu_revamped_usage "option '--json' works only with list"
  case "${1:-}" in
  apply) cpu_revamped_apply ;;
  status) cpu_revamped_status_command "${2:-}" ;;
  popup) cpu_revamped_popup ;;
  daemon) cpu_revamped_daemon_command ;;
  *)
    cpu_revamped_interface
    revamped_cli_start "${cpu_revamped_run_theme}"
    cpu_revamped_dispatch "$@"
    ;;
  esac
}

cpu_revamped_main "$@"
